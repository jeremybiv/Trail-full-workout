# --- Client-exposed (VITE_ prefix required — see src/env.d.ts). These end
# up in the browser bundle, so never put secrets here. ---
VITE_VAPID_PUBLIC_KEY=
VITE_WORKER_URL=

# --- Server-only, used by the Vercel serverless functions under /api.
# Set these in the Vercel project dashboard (Project Settings > Environment
# Variables, Production + Preview scopes). NEVER prefix these with VITE_ —
# that would bundle them into the client and leak them publicly. ---

# fal.ai API key (Kling video generation). https://fal.ai/dashboard/keys
FAL_KEY=

# Supabase project URL and service-role secret key (NOT the anon/public
# key — the service role key bypasses RLS and must stay server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the `x-admin-key` header to call
# /api/exercises/generate-video (cost-gated — real money per call).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
